# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only; never expose to the browser

# --- Data APIs ---
CFBD_API_KEY=                      # free key: https://collegefootballdata.com/key
ODDS_API_KEY=                      # free key: https://the-odds-api.com
ODDS_BOOKMAKER=draftkings

# --- Site security ---
SITE_PASSWORD=choose-a-strong-password
CRON_SECRET=long-random-string     # Vercel sends this as a Bearer token to cron routes

# Optional: force a season (defaults to the current CFB season)
# SEASON=2026
